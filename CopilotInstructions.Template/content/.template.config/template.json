{
  "$schema": "http://json.schemastore.org/template",
  "author": "DimonSmart",
  "classifications": [ "Docs", "Copilot", "Codex" ],
  "identity": "DimonSmart.CopilotInstructions",
  "name": "AI instructions files (Copilot + Codex)",
  "shortName": "copilot-instructions",
  "tags": { "language": "none", "type": "item" },
  "preferNameDirectory": false,
  "symbols": {
    "no-codex": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Do not create AGENTS.md"
    },
    "no-copilot": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Do not create .github/copilot-instructions.md"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(no-codex)",
          "exclude": [ "AGENTS.md" ]
        },
        {
          "condition": "(no-copilot)",
          "exclude": [ ".github/copilot-instructions.md" ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "CB0D7E06-1C8D-4D1E-AB2E-934F1A4B2911",
      "description": "AI instruction files created.",
      "manualInstructions": [
        { "text": "Remember to add generated files to version control: git add ." }
      ],
      "continueOnError": true
    }
  ]
}
